NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# N-ATLAS — TWO paths (see inference/README.md). Do not invent paths.
# Path A (hosted): fill ALL from official NCAIR/NAIC onboarding.
# Path B (self-host): run inference/server.py on a CUDA GPU, then use:
#   NATLAS_API_BASE_URL=http://<gpu-box-ip>:8000
#   NATLAS_LLM_PATH=/v1/chat/completions
#   NATLAS_API_KEY=self-hosted
NATLAS_API_BASE_URL=
NATLAS_API_KEY=
NATLAS_LLM_MODEL=NCAIR1/N-ATLaS
# e.g. NATLAS_LLM_PATH=/v1/chat/completions (confirm from official docs)
NATLAS_LLM_PATH=
# e.g. NATLAS_ASR_PATH=/v1/audio/transcriptions (confirm from official docs)
NATLAS_ASR_PATH=
NATLAS_ASR_YORUBA_MODEL=NCAIR1/Yoruba-ASR
NATLAS_ASR_HAUSA_MODEL=NCAIR1/Hausa-ASR
NATLAS_ASR_IGBO_MODEL=NCAIR1/Igbo-ASR
NATLAS_ASR_ENGLISH_MODEL=NCAIR1/NigerianAccentedEnglish
